# Optional locally; set a real key to enable Gemini-powered features.
# AI Studio injects this at runtime from user secrets.
GEMINI_API_KEY=

# Optional comma-separated emails allowed to bootstrap the first admin profile with Google sign-in.
ADMIN_EMAILS=

# Email OTP delivery through Resend (configure a verified sender domain).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
