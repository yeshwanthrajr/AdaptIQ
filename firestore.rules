rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function activeAdmin() {
      let admin = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return signedIn() && admin.role == 'admin' && admin.status == 'active';
    }

    // Users collection
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || activeAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'faculty']
        && request.resource.data.status == 'pending_approval';
      allow update: if signedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status)
        || (activeAdmin() && request.resource.data.role == resource.data.role)
      );
      allow delete: if activeAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if signedIn() && (request.auth.uid == userId || activeAdmin());
      }
    }

    // Faculty uploaded notes and AI personalized materials
    match /notes/{noteId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Practice assessments and tests
    match /assessments/{assessmentId} {
      allow read, write: if request.auth != null;
    }

    // Activity and login monitor logs for admin
    match /activity_logs/{logId} {
      allow read, write: if request.auth != null;
    }
  }
}

